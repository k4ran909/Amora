# Copy to .env (or run: python scripts/init_env.py, which also generates FERNET_KEY)

APP_NAME=Spark

# --- Bot tokens (at least one is required) ---
# Telegram: talk to @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Discord: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Optional: your Discord server ID, so slash commands appear instantly (global sync can take ~1h)
DISCORD_GUILD_ID=

# --- Owner (super-admin) IDs, comma-separated. Owners can never be removed from the bot. ---
# Telegram: message @userinfobot to see your numeric ID
OWNER_TG_IDS=
# Discord: Settings -> Advanced -> Developer Mode, then right-click your name -> Copy User ID
OWNER_DC_IDS=

# --- Telegram storage + admin ---
# Private channel where the bot stores every photo + profile JSON (bot must be admin). Looks like -100xxxxxxxxxx
# Leave empty during local testing: photos are then stored under data/vault/
TG_VAULT_CHANNEL_ID=
# Private admin group for review cards (bot must be a member). Empty = review cards go to owner DMs.
TG_ADMIN_CHAT_ID=

# --- Infrastructure ---
# Local dev default is SQLite. Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/spark.db
# Optional. When set, onboarding progress survives bot restarts.
REDIS_URL=

# Encrypts face embeddings at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Photo rules (optional overrides) ---
# MAX_PHOTOS=6
# FACE_MIN_SCORE=0.8
# FACE_MIN_AREA_MAIN=0.04
# FACE_MATCH_THRESHOLD=0.363
